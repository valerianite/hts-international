# PREVIEW PHASE ONLY: keep the site out of search engines until launch.
# REMOVE the X-Robots-Tag line before pointing www.hts.international at this site.
/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Catalogue PDFs change from time to time (client updates). Keep caching short so new versions show up.
/catalogues/*
  Cache-Control: public, max-age=3600
