---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | HTS International" description="This page could not be found." noindex>
  <section class="section">
    <div class="wrap">
      <p class="kicker">Error 404</p>
      <h1>Page not found</h1>
      <p>The page you were looking for has moved or doesn't exist.</p>
      <div class="btn-row">
        <a class="btn btn-primary" href="/">Back to home</a>
        <a class="btn btn-secondary" href="/products">View products</a>
        <a class="btn btn-secondary" href="/contact-us">Contact us</a>
      </div>
    </div>
  </section>
</Base>
