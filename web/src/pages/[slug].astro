---
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import { products, type Product } from '../data/products';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Product };
---
<Base title={p.title} description={p.description}>
  <div class="pagehead"><div class="wrap">
    <p class="crumbs"><a href="/">Home</a> / <a href="/products">Products</a> / {p.supplier}</p>
    <h1>{p.heading}</h1>
    <p>{p.what}</p>
  </div></div>

  <section class="section">
    <div class="wrap product-layout">
      <div class="prose" style="min-width:0">
        {p.blocks.map((b) => {
          if (b.type === 'p') return <p>{b.text}</p>;
          if (b.type === 'h2') return <h2>{b.text}</h2>;
          if (b.type === 'h3') return <h3>{b.text}</h3>;
          if (b.type === 'ul') return <ul>{b.items.map((i) => <li>{i}</li>)}</ul>;
          if (b.type === 'specs') return (
            <table class="specs"><tbody>{b.rows.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}</tbody></table>
          );
          if (b.type === 'figure') return (
            <figure class="figure">
              <Pic name={b.pic.file} alt={b.pic.alt} sizes="(min-width: 900px) 620px, 100vw" />
              {b.pic.caption && <figcaption>{b.pic.caption}</figcaption>}
            </figure>
          );
          if (b.type === 'gallery') return (
            <ul class={`gallery${b.wide ? ' wide' : ''}`}>
              {b.items.map((it) => (
                <li>
                  <figure>
                    <Pic name={it.file} alt={it.alt} sizes={b.wide ? '(min-width: 900px) 330px, 100vw' : '(min-width: 900px) 200px, 50vw'} />
                    <figcaption>{it.caption}</figcaption>
                  </figure>
                </li>
              ))}
            </ul>
          );
        })}
      </div>
      <aside class="product-aside">
        {p.cover
          ? <div class="cover"><Pic name={p.cover.file} alt={p.cover.alt} sizes="(min-width: 900px) 340px, 100vw" loading="eager" /></div>
          : <div class="placeholder" role="img" aria-label="Product photo to be supplied">Product photos to be supplied by {p.supplier}</div>}
        <div class="card">
          <h3>Interested?</h3>
          <p>Tell us what you need and we'll come back to you.</p>
          <a class="btn btn-primary" href="/contact-us#quote">Request a quote</a>
        </div>
        {p.catalogues.length > 0 && (
          <div class="card">
            <h3>Catalogues</h3>
            <ul style="margin:0">
              {p.catalogues.map((c) => <li><a href={c.href} rel="noopener">{c.label}</a></li>)}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </section>
</Base>
