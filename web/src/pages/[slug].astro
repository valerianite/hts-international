---
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import { products, type Product } from '../data/products';
import { catalogues, size } from '../lib/catalogues';
import prices from '../data/potentiometer-prices.json';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Product };
const cats = catalogues.filter((c) => c.product === p.slug);
---
<Base title={p.title} description={p.description}>
  <div class="pagehead"><div class="wrap">
    <p class="crumbs"><a href="/">Home</a> / <a href="/products">Products</a> / {p.supplier}</p>
    <h1>{p.heading}</h1>
    {p.what && <p>{p.what}</p>}
  </div></div>

  <section class="section">
    <div class="wrap product-layout">
      <div class="prose" style="min-width:0">
        {p.blocks.map((b) => {
          if (b.type === 'p') return <p>{b.text}</p>;
          if (b.type === 'h2') return <h2>{b.text}</h2>;
          if (b.type === 'h3') return <h3>{b.text}</h3>;
          if (b.type === 'ul') return <ul>{b.items.map((i) => <li>{i}</li>)}</ul>;
          if (b.type === 'specs') return (
            <div class="table-wrap">
              <table class="specs"><tbody>{b.rows.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v.split('\n').map((line, i) => <>{i > 0 && <br />}{line}</>)}</td></tr>)}</tbody></table>
            </div>
          );
          if (b.type === 'prices') return (
            <>
              <p>{prices.note} {prices.warranty}</p>
              {prices.tables.map((t) => (
                <div class="table-wrap">
                  <table class="specs prices">
                    <caption>{t.title}</caption>
                    <thead><tr><th scope="col">Part number</th><th scope="col">Description</th><th scope="col" class="num">Price (AUD, ex GST)</th></tr></thead>
                    <tbody>{t.rows.map((r) => <tr><th scope="row">{r.part}</th><td>{r.description}</td><td class="num">${r.price}{r.shipping ? ' ^' : ''}</td></tr>)}</tbody>
                  </table>
                </div>
              ))}
              <p class="small">^ {prices.shippingNote}</p>
              <p><a class="btn btn-primary" href="/contact-us#quote">Request a quote</a></p>
            </>
          );
          if (b.type === 'figure') return (
            <figure class="figure">
              <Pic name={b.pic.file} alt={b.pic.alt} sizes="(min-width: 900px) 620px, 100vw" />
              {b.pic.caption && <figcaption>{b.pic.caption}</figcaption>}
            </figure>
          );
          if (b.type === 'gallery') return (
            <ul class={`gallery${b.wide ? ' wide' : ''}`}>
              {b.items.map((it) => (
                <li>
                  <figure>
                    <Pic name={it.file} alt={it.alt} sizes={b.wide ? '(min-width: 900px) 330px, 100vw' : '(min-width: 900px) 200px, 50vw'} />
                    <figcaption>{it.caption}</figcaption>
                  </figure>
                </li>
              ))}
            </ul>
          );
        })}
      </div>
      <aside class="product-aside">
        {p.cover
          ? <div class="cover"><Pic name={p.cover.file} alt={p.cover.alt} sizes="(min-width: 900px) 340px, 100vw" loading="eager" /></div>
          : <div class="placeholder" role="img" aria-label="Product photo to be supplied">Product photos to be supplied by {p.supplier}</div>}
        <div class="card">
          <h3>Interested?</h3>
          <p>Tell us what you need and we'll come back to you.</p>
          <a class="btn btn-primary" href="/contact-us#quote">Request a quote</a>
        </div>
        {cats.length > 0 && (
          <div class="card">
            <h3>Catalogues</h3>
            <ul style="margin:0">
              {cats.map((c) => c.comingSoon
                ? <li>{c.label}: coming soon</li>
                : <li>
                    <a href={c.href} target="_blank" rel="noopener">{c.label}</a>
                    <span class="small"> {c.external ? '(opens in a new tab)' : `(PDF, ${size(c.bytes)})`}</span>
                  </li>)}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </section>
</Base>
