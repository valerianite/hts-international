---
import Base from '../layouts/Base.astro';
import { bySupplier, size } from '../lib/catalogues';
// Catalogues come from src/data/catalogues.json (approved files only, checked at build time).
// Hosted PDFs live in public/catalogues. Lone price lists are never published.
const groups = bySupplier();
---
<Base
  title="Catalogues | HTS International"
  description="Download product catalogues for Borche, Wensui, CRG, Anhyup, HALS, MACO, mould cleaning and linear potentiometers."
>
  <div class="pagehead"><div class="wrap">
    <p class="crumbs"><a href="/">Home</a> / Catalogues</p>
    <h1>Catalogues</h1>
    <p>Open or download our range of product catalogues.</p>
  </div></div>
  <section class="section">
    <div class="wrap grid cols-3">
      {groups.map((g) => (
        <div class="card">
          <h3>{g.supplier}</h3>
          <ul class="cat-list">
            {g.items.map((c) => c.comingSoon
              ? <li><span>{c.label}</span> <span class="small">Coming soon</span></li>
              : (
                <li>
                  <a href={c.href} target="_blank" rel="noopener">{c.label}</a>
                  <span class="small">
                    {c.external ? ' Opens in a new tab' : ` PDF, ${size(c.bytes)}${c.pages ? `, ${c.pages} pages` : ''}`}
                  </span>
                  {!c.external && <a class="small dl" href={c.href} download>Download</a>}
                </li>
              ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</Base>
